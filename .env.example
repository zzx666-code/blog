# ===========================================
# Blog System - Docker Environment Config
# ===========================================
# Copy this file to .env and update the values
# cp .env.example .env

# -----------------
# 必须修改的配置
# -----------------

# 数据库密码（生产环境必须修改）
POSTGRES_PASSWORD=your-secure-password-here

# JWT 密钥（至少32个字符，用于用户认证）
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters

# RustFS 访问凭据（RustFS 与后端共用）
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=your-secure-rustfs-password

# 存储桶名称。后端会在首次上传时自动创建不存在的存储桶。
S3_BUCKET=blog

# 可选：若已配置独立文件域名可填写；留空时前台通过同源代理读取文件。
S3_PUBLIC_URL=

# -----------------
# 可选配置（一般不需要修改）
# -----------------

# HTTP 端口（Nginx 反向代理）
# HTTP_PORT=80

# 日志级别 (debug, info, warn, error)
# RUST_LOG=info

# -----------------
# Docker Hub 镜像（可选）
# -----------------
# 使用预构建的镜像，无需本地构建
# BACKEND_IMAGE=yourusername/blog-backend:latest
# FRONTEND_IMAGE=yourusername/blog-frontend:latest
